=== MAVEN PROJECT / GITHUB ===

# Clone the GitHub project
git clone <github-link>

# Enter the project folder
cd <project-folder>

# Open the project in VS Code
code .


=== MAVEN VERSION / VALIDATION ===

# Check Maven version
mvn -version

# Validate pom.xml
mvn validate

# Resolve all dependencies
mvn dependency:resolve

# Show dependency tree
mvn dependency:tree

# Show effective pom.xml
mvn help:effective-pom


=== MAVEN BUILD LIFECYCLE ===

# Delete the target folder
mvn clean

# Compile the project
mvn compile

# Run tests
mvn test

# Package the project into JAR/WAR
mvn package

# Clean and package
mvn clean package

# Install the project artifact into the local repository
mvn install


=== DISPLAY TARGET FOLDER ===

# Display target folder contents in CMD
dir target

# Display target folder contents recursively
dir target /s

# Display target folder contents in PowerShell
Get-ChildItem target

# Display only files inside target
Get-ChildItem target -File


=== MAVEN LOCAL REPOSITORY ===

# Display the Windows user directory
echo %USERPROFILE%

# Go to the Maven local repository in CMD
cd /d %USERPROFILE%\.m2\repository

# Display local repository contents
dir

# Open the local Maven repository in File Explorer
explorer %USERPROFILE%\.m2\repository

# Maven local repository path
C:\Users\<username>\.m2\repository


=== ADD A MAVEN DEPENDENCY ===

# Dependency format to add inside <dependencies>
# Replace the values with the dependency given in the question

<dependency>
    <groupId>GROUP_ID</groupId>
    <artifactId>ARTIFACT_ID</artifactId>
    <version>VERSION</version>
</dependency>


=== COMMON SPRING BOOT DEPENDENCIES ===

# Spring Web
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-web</artifactId>
</dependency>

# Thymeleaf
